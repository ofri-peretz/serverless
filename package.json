{
  "name": "@interlace/serverless-monorepo",
  "version": "0.0.0",
  "description": "Open-source Serverless Framework plugins — security, performance, and developer experience in a Turborepo monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "benchmarks"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "homepage": "https://github.com/ofri-peretz/serverless#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/serverless.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/serverless/issues"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "bench": "turbo run bench",
    "bench:caching": "npm run bench:caching --workspace=@interlace/serverless-benchmarks",
    "ci:format": "prettier --check \"**/*.{md,yml,yaml,json,ts,mts,js,mjs}\"",
    "ci:oxlint": "oxlint -c .oxlintrc.json --deny=correctness --deny=suspicious --deny=perf --allow=no-await-in-loop --allow=no-shadow --allow=no-underscore-dangle --allow=unicorn/no-array-sort .",
    "ci:lint": "eslint .",
    "ci:typecheck": "tsc --noEmit -p tsconfig.json",
    "fix": "prettier --write \"**/*.{md,yml,yaml,json,ts,mts,js,mjs}\" && eslint --fix .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo run build && changeset publish",
    "changeset:status": "changeset status --verbose",
    "prepare": "lefthook install || true"
  },
  "keywords": [
    "serverless",
    "serverless-framework",
    "serverless-plugin",
    "aws-lambda",
    "cloud-functions",
    "typescript",
    "monorepo",
    "turborepo",
    "interlace",
    "security",
    "performance",
    "developer-experience"
  ],
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-conventions": "^4.1.0",
    "eslint-plugin-import-next": "^2.3.7",
    "eslint-plugin-lambda-security": "^1.2.4",
    "eslint-plugin-maintainability": "^3.0.4",
    "eslint-plugin-modernization": "^2.1.0",
    "eslint-plugin-modularity": "^2.1.0",
    "eslint-plugin-node-security": "^4.3.0",
    "eslint-plugin-operability": "^3.0.6",
    "eslint-plugin-react-a11y": "^2.1.6",
    "eslint-plugin-react-features": "^1.2.0",
    "eslint-plugin-reliability": "^3.1.4",
    "eslint-plugin-secure-coding": "^3.3.0",
    "eslint-plugin-unicorn": "^69.0.0",
    "lefthook": "^2.1.9",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.1",
    "tslib": "^2.8.1",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "~4.5.4",
    "vitest": "^4.0.18"
  }
}
