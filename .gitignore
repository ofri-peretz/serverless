# Dependencies
# Both spellings on purpose. `node_modules/` matches a directory but NOT a
# symlink of that name — git records a symlink as a file, so a worktree that
# links node_modules to a sibling checkout sails straight past the trailing
# slash and commits an absolute path to someone's laptop.
node_modules/
node_modules
.pnp
.pnp.js

# Build outputs
dist/
build/
out/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IDE - JetBrains
.idea/
*.iml

# Testing
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*~

# Turborepo
.turbo

# Miscellaneous
*.tsbuildinfo
.eslintcache

# Test results
**/test-results/
*.junit.xml

# Antigravity Stability (High Churn & Large Artifacts)
**/.turbo/**
**/dist/**
**/build/**
**/out/**
**/coverage/**
**/test-results/**
**/tmp/**
**/.cache/**
**/.eslintcache
**/*.tsbuildinfo
**/*.log
**/.DS_Store

.env*.local
.env
.vercel
