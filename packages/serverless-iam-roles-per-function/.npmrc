# AUTO-GENERATED FILE — DO NOT EDIT DIRECTLY.
# Source: interlace/package-baseline/ in the agents repo.
# Edit there, then run `npm run sync` to redistribute.
# Local edits will be refused on next sync (or overwritten with --force).
# ─────────────────────────────────────────────────────────────────────────────
# @interlace ecosystem .npmrc
# ─────────────────────────────────────────────────────────────────────────────
# Distributed by @interlace/package-baseline (in the agents repo).
# Edit the source there and run `npm run sync` — local edits will be
# refused on the next sync unless --force is used.

# Always pin lockfile (deterministic CI installs)
package-lock=true

# Enforce engines.node from package.json — refuse install on wrong Node version.
# Every published @interlace/* package declares engines.node so this is meaningful.
engine-strict=true

# Use semver ranges (caret/tilde) by default. Per-package can override locally.
save-exact=false

# Default to the public registry. Prevents accidental private-registry pickup
# from a stale ~/.npmrc on a contributor's machine.
registry=https://registry.npmjs.org/

# Block legacy peerDeps auto-install — we declare peers explicitly.
# Set to true if you actually want auto-install for end users (rare for libs).
legacy-peer-deps=false
