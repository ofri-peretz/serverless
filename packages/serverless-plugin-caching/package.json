{
  "name": "@interlace/serverless-plugin-caching",
  "version": "0.1.0",
  "description": "API Gateway caching plugin for Serverless Framework — cache clusters, flush commands, cleanup hooks, and full AWS API coverage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "serverless",
    "serverless-framework",
    "serverless-plugin",
    "api-gateway",
    "caching",
    "cache",
    "aws",
    "lambda",
    "interlace"
  ],
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ofri-peretz/serverless/tree/main/packages/serverless-plugin-caching",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/serverless.git",
    "directory": "packages/serverless-plugin-caching"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/serverless/issues"
  },
  "peerDependencies": {
    "serverless": ">=3.0.0"
  },
  "devDependencies": {
    "@interlace/serverless-devkit": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
