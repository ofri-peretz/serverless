{
  "name": "@interlace/serverless-api-gateway-caching",
  "version": "1.0.0",
  "description": "API Gateway caching plugin for Serverless Framework — cache clusters, flush commands, cleanup hooks, and full AWS API coverage",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:oxlint": "oxlint -c ../../.oxlintrc.json --deny=correctness --deny=suspicious --deny=perf --allow=no-await-in-loop --allow=no-shadow --allow=no-underscore-dangle --allow=unicorn/no-array-sort src",
    "e2e": "npm run build && tsx scripts/e2e/run.ts"
  },
  "keywords": [
    "serverless",
    "serverless-framework",
    "serverless-plugin",
    "api-gateway",
    "caching",
    "cache",
    "aws",
    "lambda",
    "interlace"
  ],
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ofri-peretz/serverless/tree/main/packages/serverless-api-gateway-caching",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/serverless.git",
    "directory": "packages/serverless-api-gateway-caching"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/serverless/issues"
  },
  "peerDependencies": {
    "serverless": ">=3.0.0",
    "@interlace/serverless-devkit": "*"
  },
  "peerDependenciesMeta": {
    "@interlace/serverless-devkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@interlace/serverless-devkit": "*",
    "tsx": "^4.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
