{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint-config/refs/heads/main/schema.json",
  "rules": {
    "no-await-in-loop": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".turbo",
    ".next",
    "coverage",
    "apps/docs/.source",
    "**/.interlace/**"
  ]
}
